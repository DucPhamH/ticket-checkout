# Copy to .env and fill in. Never commit .env.

# --- Database (used when running api outside Docker; compose sets its own) ---
DATABASE_URL=postgresql://tc:tc@localhost:5432/tc

# --- Public URLs (what the browser sees) ---
WEB_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# --- Web -> API (server-side). Outside Docker: localhost; compose overrides with http://api:4000 ---
API_INTERNAL_URL=http://localhost:4000

# --- VNPay sandbox (register at https://sandbox.vnpayment.vn/devreg/) ---
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# --- ngrok (optional, only for receiving IPN locally: docker compose --profile tunnel up) ---
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
